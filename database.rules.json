{
  "rules": {
    "scans": {
      // Anyone can read a scan to view the QR content
      ".read": true,
      
      "$scanId": {
        // Write logic:
        // 1. Must be authenticated.
        // 2. CREATE: Can create new scan if uid matches auth.uid.
        // 3. DELETE / UPDATE: Owner (uid matches auth.uid) or Admin or Expired scans.
        ".write": "auth != null && ( (!data.exists() && newData.child('uid').val() === auth.uid) || (data.child('uid').val() === auth.uid) || (root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin') || (!newData.exists() && data.child('expiresAt').exists() && data.child('expiresAt').val() < now) )",
        
        // Validate the structure of the data when creating
        ".validate": "newData.hasChildren(['uid', 'type', 'data', 'timestamp'])",
        
        "type": {
          ".validate": "newData.val() == 'url' || newData.val() == 'image' || newData.val() == 'document'"
        },
        "data": {
          // Limit payload size to ~15MB (protects against payload bombing)
          ".validate": "newData.isString() && newData.val().length < 15000000"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    
    "users": {
      // Admins can read the entire users list
      ".read": "auth != null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      "$uid": {
        // Normal users can read and write their own data. Admins can write to anyone's data.
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid || (auth != null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin')"
      }
    },
    
    "deleted_users": {
      "$uid": {
        // No one can read this data except Admin
        ".read": false,
        // The user can create this record when deleting their account
        ".write": "$uid === auth.uid && !data.exists()"
      }
    },
    
    "qr_logs": {
      "$scanId": {
        // No one can read logs except Admin
        ".read": false,
        // Only allow creating a log (not updating/deleting) if authenticated and uid matches
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'ip_address', 'timestamp'])"
      }
    },

    "contactUs": {
      // Admins can read all contact requests
      ".read": "auth != null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      "$contactId": {
        // Anyone (authenticated or not) can create a contact request, but not update or delete
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['email', 'description', 'timestamp'])"
      }
    },

    "refundRequests": {
      // Admins can read all refund requests
      ".read": "auth != null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      "$requestId": {
        // Only authenticated users can create a refund request (not update/delete)
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'email', 'reason', 'timestamp'])"
      }
    }
  }
}
